# --- ENVIRONMENT CONFIGURATION EXAMPLE (.env.example) ---
# All secrets and environment variables must be documented here.
# Production & Staging: Mandatory values MUST be provided in the environment.
# Development & Test: Safe local defaults are provided by the configuration layer.

# --- SECURITY & SECRETS (REQUIRED IN PRODUCTION / STAGING) ---

# RS256 access-token signing. In production/staging inject the PEM values from secret custody.
# For multiline env stores, escaped \n is accepted and normalized at startup.
JWT_ACTIVE_KEY_ID=manaratak-key-2026-01
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Optional overlap keys for rotation, JSON object: {"old-kid":"-----BEGIN PUBLIC KEY-----\n..."}
JWT_PREVIOUS_PUBLIC_KEYS_JSON={}
ACCESS_TOKEN_TTL_SECONDS=900
JWT_ISSUER=manaratak-production-api
JWT_AUDIENCE=manaratak-production-browser
SECURE_COOKIE=true
TRUST_PROXY_HOPS=1

# CSRF Secret: Used for anti-CSRF token HMAC signing.
# Production/Staging: REQUIRED (Minimum 32 characters long).
# Development/Test Default: Provided automatically by AppConfig.
CSRF_SECRET=your-32-character-csrf-secret-placeholder

# Admin access always uses authenticated identities and persisted RBAC.
ADMIN_AUTH_MODE=strict


# --- DATABASE & INFRASTRUCTURE ---

# Runtime environment used by typed configuration and database mutation target validation.
# Valid values: development | test | staging | production
NODE_ENV=development

# Database Connection URL: PostgreSQL connection string in production/staging.
# Production/Staging: REQUIRED (Must be a non-local HTTPS/PostgreSQL URL).
# Development default: local PostgreSQL database `manaratak_dev`.
# Test environments must provide an isolated PostgreSQL test database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manaratak_dev

# --- GREENFIELD DATABASE MUTATION GATE ---
# These variables are intentionally NOT safe defaults. Keep the gate unapproved unless a controlled
# provisioning/migration/seed/import/backfill/maintenance operation is being executed.
# 1) Explicitly approve the Greenfield Database Provisioning Gate.
DATABASE_PROVISIONING_GATE=PENDING
# 2) Explicitly authorize writes for this process.
ALLOW_DATABASE_MUTATIONS=NO
# 3) Declare the runtime environment and operation purpose. Must match NODE_ENV.
DATABASE_MUTATION_ENVIRONMENT=development
DATABASE_MUTATION_PURPOSE=provision
# 4) Confirm the non-secret target identity derived from DATABASE_URL: host:port/database.
DATABASE_MUTATION_TARGET=localhost:5432/manaratak_dev
# Production only: both are additionally mandatory for database mutations.
ALLOW_PRODUCTION_DATABASE_MUTATIONS=NO
DATABASE_PRODUCTION_CHANGE_ID=

# Redis Connection URL: Used for queue management and distributed rate limiting cache.
# Production/Staging: REQUIRED. No in-memory fallback is permitted for distributed runtime state.
# Development/Test Default: 'redis://localhost:6379'.
REDIS_URL=redis://redis-host:6379
REDIS_NAMESPACE=manaratak:


# --- NETWORKING & CORS ---

# Public Application Base URL: API base URL for external clients.
# Production/Staging: REQUIRED (Must start with https://).
# Development/Test Default: 'http://localhost:3000'.
API_BASE_URL=https://api.manaratak.org

# CORS Allowed Origin: Web application frontend origin URL.
# Production/Staging: REQUIRED (Wildcards '*' are strictly forbidden).
# Development/Test Default: 'http://localhost:3000'.
CORS_ORIGIN=https://app.manaratak.org

# Public web origin used by the read-only Health & Readiness reachability probe.
# If omitted, the API falls back to CORS_ORIGIN. Production/Staging should use HTTPS.
PUBLIC_WEB_URL=https://app.manaratak.org
# Canonical Admin HTML origin. Production/Staging: REQUIRED (HTTPS).
ADMIN_WEB_URL=https://admin.manaratak.org


# --- OPTIONAL RUNTIME CONFIGURATION ---

# Logging level: trace, debug, info, warn, error. Defaults to 'info'.
LOG_LEVEL=info

# OpenTelemetry Service Name for performance monitoring and trace tracking.
OTEL_SERVICE_NAME=manaratak-api
# Production/Staging: REQUIRED. HTTPS OpenTelemetry collector/gateway endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com

# Content Security Policy (CSP): Set to true to enable strict security headers.
SECURITY_CSP_ENABLED=true

# Rate limiting settings:
SECURITY_RATE_LIMIT_MAX=100
SECURITY_RATE_LIMIT_WINDOW_MS=60000

# P13 -> P14 certificate completion delivery worker.
# Production/Staging: REQUIRED and must be enabled; development/test may disable it.
CERTIFICATE_COMPLETION_WORKER_ENABLED=true
CERTIFICATE_COMPLETION_WORKER_INTERVAL_MS=5000
STUDENT_WORKSPACE_OUTBOX_WORKER_ENABLED=true
STUDENT_WORKSPACE_OUTBOX_WORKER_INTERVAL_MS=2000
OWNER_DOMAIN_OUTBOX_WORKER_ENABLED=true
OWNER_DOMAIN_OUTBOX_WORKER_INTERVAL_MS=2000
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_WORKER_INTERVAL_MS=2000
BACKGROUND_WORKER_BATCH_SIZE=10
BACKGROUND_WORKER_LEASE_MS=60000
BACKGROUND_WORKER_HEARTBEAT_MS=15000
# Five-field UTC cron; default retention sweep runs daily at 02:15 UTC.
BACKGROUND_RETENTION_CRON=15 2 * * *
BACKGROUND_CMS_CRON=* * * * *
BACKGROUND_IMPORT_CRON=* * * * *
BACKGROUND_AI_CRON=* * * * *
BACKGROUND_FINANCE_RECONCILIATION_CRON=*/5 * * * *
BACKGROUND_NOTIFICATION_CRON=* * * * *
NOTIFICATION_RECIPIENT_MAX_DELIVERIES_PER_HOUR=30

# Local Storage root path for temporary file processing.
STORAGE_BASE_PATH=./storage


# --- FRONTEND ENVIRONMENT VARIABLES (VITE) ---

# Admin Application Routing URL.
VITE_ADMIN_URL=http://localhost:3001

# Public Web Application URL used by admin deep links.
VITE_PUBLIC_WEB_URL=http://localhost:3000

# Public Web Application Base API Endpoint override.
VITE_API_URL=/api/v1

# Local-only Admin preview. Keep false in shared, staging, and production environments.
# When true, legacy /admin preview routes are visible and the Vite API bridge blocks non-read requests.
VITE_LOCAL_ADMIN_READ_ONLY=false

# Certificate verification link embedded in QR codes.
CERTIFICATE_PUBLIC_VERIFICATION_BASE_URL=https://app.manaratak.org
CERTIFICATE_SIGNING_KEY_REFERENCE=kms://your-certificate-signing-key
# Development/test only. Production should use the approved KMS/HSM signing provider.
CERTIFICATE_SIGNING_SECRET=development-only-certificate-signing-secret

# --- PHASE 05 ENTERPRISE ASSET PROVIDER (W3 / MNT-AUD-0011) ---
# Production/Staging: all three values are REQUIRED. The API fails closed when they are absent or partial.
# The provider endpoint must implement the signed MANARATAK Asset Provider Contract documented in
# docs/operations/ASSET_PROVIDER_RUNTIME.md. HTTPS is mandatory in production/staging.
MANARATAK_ASSET_PROVIDER_BASE_URL=https://asset-provider.example.invalid/api/
MANARATAK_ASSET_PROVIDER_API_KEY=replace-at-runtime
MANARATAK_ASSET_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-bytes-at-runtime
MANARATAK_ASSET_PROVIDER_TIMEOUT_MS=10000
MANARATAK_ASSET_PROVIDER_MAX_RESPONSE_BYTES=67108864
# Development-only escape hatch for a local provider sandbox. Never enable in production/staging.
MANARATAK_ASSET_PROVIDER_ALLOW_INSECURE_HTTP=false

# Import raw provenance retention (provider-enforced)
MANARATAK_IMPORT_RAW_RETENTION_DAYS=365

# Finance provider transport (required in staging/production)
FINANCE_PROVIDER_BASE_URL=https://finance-provider.example.com
FINANCE_PROVIDER_API_KEY=replace-with-provider-api-key
FINANCE_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-random-characters
FINANCE_PAYMENT_PROVIDER_KEY=primary-payment
FINANCE_FX_PROVIDER_KEY=primary-fx
FINANCE_BANK_PROVIDER_KEY=primary-bank
FINANCE_PROVIDER_TIMEOUT_MS=10000
FINANCE_PROVIDER_MAX_ATTEMPTS=3
FINANCE_PROVIDER_ALLOW_INSECURE_HTTP=false


# Notification provider transport (required in staging/production)
NOTIFICATION_PROVIDER_BASE_URL=https://notification-provider.example.com
NOTIFICATION_PROVIDER_API_KEY=replace-with-provider-api-key
NOTIFICATION_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
NOTIFICATION_PROVIDER_ALLOW_INSECURE_HTTP=false
