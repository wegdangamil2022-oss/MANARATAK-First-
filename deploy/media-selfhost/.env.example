# Copy outside the repository. Pin scanned Debian bookworm-slim / ClamAV base images by digest.
NODE_IMAGE=
CLAMAV_IMAGE=
MEDIA_DATA_DIR=/srv/manaratak-media
MEDIA_SECRET_DIR=/srv/manaratak-media-secrets
MEDIA_UID=10001
MEDIA_GID=10001
MEDIA_PORT=8443
MEDIA_PUBLIC_ORIGIN=https://media.example.invalid
MEDIA_ALLOWED_ORIGINS=https://www.example.invalid,https://admin.example.invalid
# Apply only to an isolated API environment after running acceptance tests:
MANARATAK_ASSET_PROVIDER_BASE_URL=https://media.example.invalid
MANARATAK_ASSET_PROVIDER_TIMEOUT_MS=120000
MANARATAK_ASSET_PROVIDER_MAX_RESPONSE_BYTES=67108864
# API key/signing secret must be injected from the private files, never copied into git.
