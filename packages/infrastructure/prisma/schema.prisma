datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- System & Core ---

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model ImportSourceRegistryEntry {
  sourceId             String   @id
  displayName          String
  baseUrl              String
  category             String
  accessClassification String
  status               String
  rateLimitPerMinute   Int?
  robotsPolicyUrl      String?
  connectorId          String
  connectorVersion     String
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ScholarshipImportVerificationDecision {
  id            String   @id
  recordId      String
  state         String
  actorId       String
  reason        String
  evidence      Json?
  correlationId String?
  createdAt     DateTime @default(now())
  record        ImportRecord @relation("ScholarshipVerificationDecisionRecord", fields: [recordId], references: [id], onDelete: Cascade)
  @@index([recordId, createdAt])
}

model ScholarshipImportCanonicalResolutionDecision {
  id                 String   @id
  recordId           String
  fieldOrRequirementKey String
  canonicalEntityType String
  canonicalId        String?
  rawValue           String
  resolutionType     String
  actorId            String
  reason             String?
  correlationId      String?
  createdAt          DateTime @default(now())
  record             ImportRecord @relation("ScholarshipCanonicalDecisionRecord", fields: [recordId], references: [id], onDelete: Cascade)
  @@index([recordId, createdAt])
}

// --- Settings Foundation ---

model SettingDefinitionRecord {
  id            String   @id
  key           String   @unique
  valueType     String
  description   String?
  defaultValue  Json?
  isFeatureFlag Boolean  @default(false)
  isDeprecated  Boolean  @default(false)
  isSecret      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SettingAssignmentRecord {
  id               String   @id
  key              String
  scopeLevel       String
  scopeId          String
  currentVersionId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions SettingVersionRecord[]

  @@unique([key, scopeLevel, scopeId])
  @@index([key])
  @@index([scopeLevel, scopeId])
}

model SettingVersionRecord {
  id                  String   @id
  assignmentId        String
  value               Json
  valueType           String
  authorId            String?
  createdAt           DateTime @default(now())
  rollbackOfVersionId String?

  assignment SettingAssignmentRecord @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId, createdAt])
}

// --- Import Foundation ---

model ImportBatch {
  id               String    @id @default(uuid())
  sourceSystem     String
  dataType         String
  batchStatus      String
  totalRecords     Int       @default(0)
  processedRecords Int       @default(0)
  failedRecords    Int       @default(0)
  attemptCount     Int       @default(0)
  availableAt      DateTime  @default(now())
  claimedBy        String?
  claimUntil       DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  records ImportRecord[]

  @@index([batchStatus])
  @@index([dataType])
  @@index([batchStatus, dataType])
  @@index([batchStatus, availableAt])
  @@index([claimUntil])
}

model ImportRecord {
  id                 String    @id @default(uuid())
  batchId            String
  status             String
  rawPayload         Json
  validationErrors   Json?
  processingNotes    String?
  sourceDedupKey     String?
  promotedEntityId   String?
  chunkIndex         Int?
  recordOffset       Int?
  sourceRowNumber    Int?
  retentionExpiresAt DateTime?
  legalHoldUntil       DateTime?
  retentionProcessedAt DateTime?
  retentionState       String    @default("PENDING")
  retentionClaimUntil  DateTime?
  retentionClaimToken  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  batch ImportBatch @relation(fields: [batchId], references: [id])
  scholarshipVerificationDecisions ScholarshipImportVerificationDecision[] @relation("ScholarshipVerificationDecisionRecord")
  scholarshipCanonicalResolutionDecisions ScholarshipImportCanonicalResolutionDecision[] @relation("ScholarshipCanonicalDecisionRecord")

  @@unique([batchId, sourceDedupKey])
  @@index([retentionExpiresAt, retentionProcessedAt])
  @@index([batchId])
  @@index([batchId, status])
  @@index([batchId, chunkIndex])
  @@index([retentionExpiresAt])
}

// --- Phase 13 Learning Platform: Core Course Persistence ---

model Course {
  id                   String   @id @default(uuid())
  publicId             String   @unique
  slug                 String   @unique
  canonicalName        String
  canonicalDedupKey    String   @unique
  displayName          String
  accessType           String
  originType           String
  directCourseUrl      String
  status               String
  completenessStatus   String
  version              Int      @default(1)

  externalProviderId               String?
  originalSourceTitle              String?
  isStudyFree                      Boolean?
  isFreeCertificate                Boolean?
  certificateType                  String?
  learningLanguageRaw              String?
  learningLanguageReferenceId      String?
  learningLanguageResolutionState  String   @default("UNRESOLVED")
  learningLanguageResolutionMethod String?
  learningLanguageResolvedAt       DateTime?
  learningLanguageReviewedBy        String?
  learningLanguageAdminReviewedRaw  String?
  studyLevelRaw                    String?
  studyDurationRaw                 String?
  shortCourseTopicsRaw             String?

  platformName         String?
  providerName         String?
  learningLanguage     String?
  studyDuration        String?
  certificateAvailable Boolean?
  category             String?
  difficultyLevel      String?
  sourceUrl            String?
  officialSourceUrl    String?
  thumbnailAssetId     String?
  sourceImportRecordId String?
  optionalFields       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalProvider           ExternalCourseProvider?        @relation(fields: [externalProviderId], references: [id], onDelete: SetNull)
  learningLanguageReference  ReferenceLanguage?             @relation("CourseLearningLanguageReference", fields: [learningLanguageReferenceId], references: [id], onDelete: SetNull)
  sourceIdentities           CourseSourceIdentity[]
  importAnalyses             CourseImportAnalysis[]
  fieldProvenance            CourseFieldProvenance[]
  taxonomyResolutions        CourseTaxonomyResolution[]
  academicTaxonomyLinks      CourseAcademicTaxonomyLink[]
  majorProjections           CourseMajorProjection[]
  internationalTestRelationships CourseInternationalTestRelationship[]
  modules                    CourseModule[]
  lessons                    CourseLesson[]
  lessonAssets               CourseLessonAsset[]
  quizzes                    CourseQuiz[]
  questionBanks              CourseQuestionBank[]
  questions                  CourseQuestion[]
  enrollments                CourseEnrollment[]
  lessonProgress             CourseLessonProgress[]
  quizAttempts               CourseQuizAttempt[]
  completions                CourseCompletion[]
  versions                   CourseVersion[]
  enrollmentPolicy           CourseEnrollmentPolicy?
  learningPathCourses        LearningPathCourse[]

  @@index([status])
  @@index([completenessStatus])
  @@index([accessType])
  @@index([originType])
  @@index([externalProviderId])
  @@index([learningLanguageReferenceId])
  @@index([learningLanguageResolutionState])
  @@index([platformName])
  @@index([sourceImportRecordId])
  @@index([status, originType])
  @@index([status, platformName])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  position    Int
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
  quizzes CourseQuiz[]

  @@unique([courseId, position])
  @@index([courseId, status])
}

model CourseLesson {
  id                       String   @id @default(uuid())
  courseId                 String
  moduleId                 String
  title                    String
  summary                  String?
  lessonType               String
  position                 Int
  estimatedDurationMinutes Int?
  contentText              String?
  status                   String   @default("DRAFT")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  course   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assets   CourseLessonAsset[]
  quizzes  CourseQuiz[]
  progress CourseLessonProgress[]

  @@unique([moduleId, position])
  @@index([courseId, status])
  @@index([moduleId])
}

model CourseLessonAsset {
  id             String   @id @default(uuid())
  courseId       String
  lessonId       String
  assetId        String
  assetReference String?
  title          String?
  assetType      String
  position       Int
  isRequired     Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@unique([lessonId, assetId])
  @@index([courseId])
  @@index([assetId])
}

model CourseQuiz {
  id           String   @id @default(uuid())
  courseId     String
  moduleId     String?
  lessonId     String?
  title        String
  instructions String?
  position     Int
  passingScore Int?
  maxAttempts  Int?
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    CourseModule?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson    CourseLesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions CourseQuestion[]
  attempts  CourseQuizAttempt[]

  @@unique([courseId, position])
  @@index([moduleId])
  @@index([lessonId])
  @@index([courseId, status])
}

model CourseQuestionBank {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions CourseQuestion[]

  @@index([courseId, status])
}

model CourseQuestion {
  id             String   @id @default(uuid())
  courseId       String
  version        Int      @default(1)
  quizId         String?
  questionBankId String?
  questionType   String
  prompt         String
  choices        Json?
  correctAnswer  Json?
  explanation    String?
  points         Int      @default(1)
  position       Int
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz         CourseQuiz?         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionBank CourseQuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  versions     CourseQuestionVersion[]

  @@index([courseId, status])
  @@index([quizId, position])
  @@index([questionBankId])
}

model CourseEnrollment {
  id                  String   @id @default(uuid())
  courseId            String
  studentReferenceId  String
  status              String   @default("ACTIVE")
  enrolledAt          DateTime @default(now())
  completedAt         DateTime?
  progressPercentage  Int      @default(0)
  lastAccessedAt      DateTime?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentReferenceId])
  @@index([studentReferenceId, status])
}

model CourseLessonProgress {
  id                 String   @id @default(uuid())
  courseId           String
  lessonId           String
  studentReferenceId String
  status             String
  progressPercentage Int      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  timeSpentSeconds   Int?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([courseId, lessonId, studentReferenceId])
  @@index([studentReferenceId, status])
}

model CourseQuizAttempt {
  id                 String   @id @default(uuid())
  courseId           String
  quizId             String
  studentReferenceId String
  attemptNumber      Int
  status             String   @default("IN_PROGRESS")
  score              Float?
  passed             Boolean?
  answers            Json?
  startedAt          DateTime @default(now())
  submittedAt        DateTime?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  quiz   CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Restrict)

  @@unique([quizId, studentReferenceId, attemptNumber])
  @@index([courseId, studentReferenceId])
}

model CourseCompletion {
  id                     String   @id @default(uuid())
  courseId               String
  studentReferenceId     String
  status                 String
  completionSource       String
  eligibleForCertificate Boolean  @default(false)
  courseVersion          Int
  completedAt            DateTime @default(now())
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentReferenceId])
  @@index([studentReferenceId, status])
}

model CourseVersion {
  id            String   @id @default(uuid())
  courseId      String
  versionNumber Int
  reason        String
  snapshot      Json
  createdBy     String?
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, versionNumber])
  @@index([courseId, createdAt])
}

model CourseQuestionVersion {
  id            String   @id @default(uuid())
  questionId    String
  versionNumber Int
  reason        String
  snapshot      Json
  createdBy     String?
  createdAt     DateTime @default(now())

  question CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([questionId, versionNumber])
  @@index([questionId, createdAt])
}

model CourseEnrollmentPolicy {
  courseId                   String   @id
  isCapacityLimited          Boolean  @default(false)
  maximumSeats               Int?
  requiresApproval           Boolean  @default(false)
  waitlistEnabled            Boolean  @default(false)
  prerequisiteCourseIds      Json
  eligibilityRules           Json?
  requiresFinancialClearance Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id                String   @id @default(uuid())
  publicId          String   @unique
  slug              String   @unique
  title             String
  description       String?
  status            String   @default("DRAFT")
  version           Int      @default(1)
  isStrictlyOrdered Boolean  @default(false)
  completionLogic   String   @default("ALL_REQUIRED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions    LearningPathVersion[]
  enrollments LearningPathEnrollment[]

  @@index([status])
}

model LearningPathVersion {
  id             String   @id @default(uuid())
  learningPathId String
  versionNumber  Int
  status         String
  snapshot       Json
  createdAt      DateTime @default(now())

  learningPath LearningPath         @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  courses      LearningPathCourse[]

  @@unique([learningPathId, versionNumber])
  @@index([learningPathId, status])
}

model LearningPathCourse {
  id                     String   @id @default(uuid())
  learningPathVersionId  String
  courseId               String
  position               Int
  required               Boolean  @default(true)
  prerequisiteCourseIds  Json
  createdAt              DateTime @default(now())

  learningPathVersion LearningPathVersion @relation(fields: [learningPathVersionId], references: [id], onDelete: Cascade)
  course              Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([learningPathVersionId, position])
  @@unique([learningPathVersionId, courseId])
  @@index([courseId])
}

model LearningPathEnrollment {
  id                  String   @id @default(uuid())
  learningPathId      String
  learningPathVersion Int
  studentReferenceId  String
  status              String   @default("ACTIVE")
  progressPercentage  Int      @default(0)
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Restrict)

  @@unique([learningPathId, studentReferenceId])
  @@index([studentReferenceId, status])
}

// --- Phase 14 Enterprise Certificates Platform ---

model CertificateIssuer {
  id                     String   @id @default(uuid())
  publicId               String   @unique
  code                   String   @unique
  name                   String
  issuerType             String
  status                 String   @default("ACTIVE")
  organizationId         String?
  universityId           String?
  issuerLogoAssetId      String
  signingKeyReference    String
  accreditationAuthority String?
  accreditationReference String?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  templates        CertificateTemplate[]
  templateVersions CertificateTemplateVersion[]
  certificates     Certificate[]

  @@index([status])
  @@index([universityId])
}

model CertificateTemplate {
  id               String   @id @default(uuid())
  publicId         String   @unique
  code             String   @unique
  name             String
  nameAr           String
  nameEn           String
  status           String   @default("DRAFT")
  issuerId         String?
  currentVersionId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issuer         CertificateIssuer?         @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  versions       CertificateTemplateVersion[] @relation("CertificateTemplateVersions")
  currentVersion CertificateTemplateVersion?  @relation("CurrentCertificateTemplateVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  certificates   Certificate[]

  @@index([status])
  @@index([issuerId])
}

model CertificateTemplateVersion {
  id                   String   @id @default(uuid())
  publicId             String   @unique
  templateId           String
  issuerId             String
  versionNumber        String
  status               String   @default("DRAFT")
  language             String   @default("BILINGUAL")
  layout               String   @default("LANDSCAPE")
  accentColor          String   @default("#142B5F")
  secondaryColor       String   @default("#D6A43B")
  titleAr              String
  titleEn              String
  bodyAr               String
  bodyEn               String
  signatoryNameAr      String?
  signatoryNameEn      String?
  signatoryTitleAr     String?
  signatoryTitleEn     String?
  logoAssetId          String?
  sealAssetId          String?
  signatureAssetId     String?
  designAssetId        String?
  validityPolicy       String   @default("PERMANENT")
  validityDurationDays Int?
  renewalPeriodDays    Int?
  renewalPolicy        String?
  requiresRevalidation Boolean  @default(false)
  metadata             Json?
  createdBy            String
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime @default(now())

  template           CertificateTemplate  @relation("CertificateTemplateVersions", fields: [templateId], references: [id], onDelete: Restrict)
  issuer             CertificateIssuer    @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  currentForTemplate CertificateTemplate? @relation("CurrentCertificateTemplateVersion")
  certificates       Certificate[]

  @@unique([templateId, versionNumber])
  @@index([templateId, createdAt])
  @@index([issuerId])
  @@index([status])
}

model Certificate {
  id                       String   @id @default(uuid())
  publicId                 String   @unique
  serialNumber             String   @unique
  verificationCode         String   @unique
  verificationUrl          String?
  verificationHash         String   @unique
  status                   String   @default("ACTIVE")
  certificateType          String   @default("COURSE")
  studentReferenceId       String
  recipientDisplayName     String?
  achievementType          String?
  achievementId            String?
  achievementDisplayName   String?
  sourceCompletionId       String?
  completedAt              DateTime?
  sourceEventId            String?  @unique
  sourceEventType          String?
  sourceEventVersion       String?
  sourceEventPayloadHash   String?
  courseId                 String?
  courseDisplayName        String?
  courseCompletionId       String?
  courseCompletedAt        DateTime?
  learningPathId           String?
  learningPathDisplayName  String?
  learningPathCompletionId String?
  issuedAt                 DateTime @default(now())
  expiresAt                DateTime?
  validityPolicy           String   @default("PERMANENT")
  renewalPolicy            String?
  requiresRevalidation     Boolean  @default(false)
  templateId               String?
  templateVersionId        String?
  templateVersion          String
  issuerId                 String?
  certificatePdfAssetId    String?
  previewImageAssetId      String?
  verificationQrAssetId    String?
  signatureAssetId         String?
  digitalSignature         String?
  signingKeyReference      String?
  issuerName               String?
  issuerReferenceId        String?
  grade                    String?
  score                    Float?
  skills                   Json
  competencies             Json
  revokedAt                DateTime?
  revocationReason         String?
  revokedBy                String?
  replacesCertificateId    String?
  replacedByCertificateId  String?
  archivedAt               DateTime?
  metadata                 Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  template             CertificateTemplate?       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersionRecord CertificateTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  issuer               CertificateIssuer?         @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  ledgerEntries        CertificateLedgerEntry[]
  verificationLogs     CertificateVerificationLog[]
  issuanceInbox        CertificateIssuanceInbox?
  replacesCertificate  Certificate?               @relation("CertificateReplaces", fields: [replacesCertificateId], references: [id], onDelete: Restrict)
  replacementFor       Certificate[]              @relation("CertificateReplaces")
  replacedByCertificate Certificate?              @relation("CertificateReplacedBy", fields: [replacedByCertificateId], references: [id], onDelete: Restrict)
  replacedSources      Certificate[]              @relation("CertificateReplacedBy")

  @@index([studentReferenceId, status])
  @@index([achievementType, sourceCompletionId])
  @@index([courseCompletionId])
  @@index([learningPathCompletionId])
  @@index([courseId, studentReferenceId])
  @@index([learningPathId, studentReferenceId])
  @@index([templateId])
  @@index([templateVersionId])
  @@index([issuerId])
  @@index([issuedAt])
  @@index([expiresAt])
}

model CertificateIssuanceInbox {
  eventId       String   @id
  eventType     String
  eventVersion  String
  sourceDomain  String
  payloadHash   String
  certificateId String   @unique
  processedAt   DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([eventType, processedAt])
}

model CertificateLedgerEntry {
  id            String   @id @default(uuid())
  certificateId String
  action        String
  actorId       String
  reason        String?
  payload       Json?
  occurredAt    DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([certificateId, occurredAt])
  @@index([action])
}

model CertificateVerificationLog {
  id            String   @id @default(uuid())
  certificateId String?
  result        String
  channel       String
  occurredAt    DateTime @default(now())

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([certificateId, occurredAt])
  @@index([result, occurredAt])
}

model CourseTaxonomyResolution {
  id                       String   @id @default(uuid())
  courseId                 String
  sourceTerm               String
  normalizedTerm           String
  status                   String   @default("UNRESOLVED")
  candidateTaxonomyNodeIds Json
  chosenTaxonomyNodeId     String?
  matchMethod              String?
  confidence               Float?
  sourceImportRecordId     String?
  reviewedBy               String?
  reviewedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  course             Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chosenTaxonomyNode AcademicTaxonomyNode?          @relation("CourseTaxonomyResolutionChosenNode", fields: [chosenTaxonomyNodeId], references: [id], onDelete: SetNull)
  taxonomyLinks      CourseAcademicTaxonomyLink[]

  @@unique([courseId, normalizedTerm])
  @@index([courseId])
  @@index([status])
  @@index([chosenTaxonomyNodeId])
}

model CourseAcademicTaxonomyLink {
  id                   String   @id @default(uuid())
  courseId             String
  taxonomyNodeId       String
  sourceResolutionId   String?
  relationshipType     String   @default("RELATED")
  reviewState          String   @default("PROPOSED")
  matchMethod          String
  sourceTerm           String
  confidence           Float?
  sourceImportRecordId String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course           Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  taxonomyNode     AcademicTaxonomyNode      @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  sourceResolution CourseTaxonomyResolution? @relation(fields: [sourceResolutionId], references: [id], onDelete: SetNull)
  majorProjections CourseMajorProjection[]

  @@unique([courseId, taxonomyNodeId, relationshipType])
  @@index([courseId])
  @@index([taxonomyNodeId])
  @@index([reviewState])
  @@index([sourceResolutionId])
}

model CourseMajorProjection {
  id                                 String   @id @default(uuid())
  projectionKey                      String   @unique
  courseId                           String
  majorId                            String
  profileId                          String?
  taxonomyNodeId                     String?
  sourceCourseTaxonomyLinkId         String?
  sourceMajorClassificationMappingId String?
  sourceType                         String
  relationshipType                   String
  projectionState                    String   @default("PROPOSED")
  confidence                         Float?
  reviewedBy                         String?
  reviewedAt                         DateTime?
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  course                           Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  major                            Major                        @relation(fields: [majorId], references: [id], onDelete: Cascade)
  profile                          MajorLevelProfile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  taxonomyNode                     AcademicTaxonomyNode?        @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  sourceCourseTaxonomyLink         CourseAcademicTaxonomyLink? @relation(fields: [sourceCourseTaxonomyLinkId], references: [id], onDelete: SetNull)
  sourceMajorClassificationMapping MajorClassificationMapping? @relation(fields: [sourceMajorClassificationMappingId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([majorId])
  @@index([profileId])
  @@index([taxonomyNodeId])
  @@index([projectionState])
  @@index([sourceCourseTaxonomyLinkId])
  @@index([sourceMajorClassificationMappingId])
}


model CourseInternationalTestRelationship {
  id                  String   @id @default(uuid())
  courseId            String
  internationalTestId String
  relationshipType    String
  reviewState         String   @default("PROPOSED")
  sourceType          String   @default("ADMIN_AUTHORED")
  createdBy           String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  internationalTest InternationalTest @relation(fields: [internationalTestId], references: [id], onDelete: Cascade)

  @@unique([courseId, internationalTestId, relationshipType])
  @@index([courseId, reviewState])
  @@index([internationalTestId, reviewState])
}

model ExternalCourseProvider {
  id                             String   @id @default(uuid())
  publicId                       String   @unique
  slug                           String   @unique
  canonicalName                  String
  normalizedCanonicalName        String   @unique
  displayName                    String
  providerType                   String?
  status                         String
  officialWebsite                String?
  operatingScope                 String?
  headquartersCountryReferenceId String?
  sourceTrustLevel               String
  importStrategy                 String
  directCoursePathPatterns       Json?
  connectorKey                   String?
  connectorVersion               String?
  lastVerifiedAt                 DateTime?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  headquartersCountry      ReferenceCountry?               @relation("ExternalCourseProviderHeadquartersCountry", fields: [headquartersCountryReferenceId], references: [id], onDelete: SetNull)
  aliases                  ExternalCourseProviderAlias[]
  allowedDomains           ExternalCourseProviderDomain[]
  courses                  Course[]
  sourceIdentities         CourseSourceIdentity[]
  providerCandidateAnalyses CourseImportAnalysis[]          @relation("CourseImportAnalysisProviderCandidate")
  resolvedProviderAnalyses CourseImportAnalysis[]           @relation("CourseImportAnalysisResolvedProvider")
  fieldProvenance          CourseFieldProvenance[]

  @@index([status])
  @@index([headquartersCountryReferenceId])
  @@index([importStrategy])
}

model ExternalCourseProviderAlias {
  id              String   @id @default(uuid())
  providerId      String
  alias           String
  normalizedAlias String   @unique
  locale          String?
  source          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider ExternalCourseProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ExternalCourseProviderDomain {
  id               String   @id @default(uuid())
  providerId       String
  domain           String
  normalizedDomain String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider ExternalCourseProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, normalizedDomain])
  @@index([normalizedDomain])
}

model CourseSourceIdentity {
  id                      String   @id @default(uuid())
  courseId                String?
  providerId              String
  sourceNativeKey         String
  identityStrategy        String
  originalTitle           String
  normalizedOriginalTitle String
  languageVersionKey      String   @default("")
  currentUrl              String
  firstSeenAt             DateTime @default(now())
  lastSeenAt              DateTime @default(now())
  status                  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  course     Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  provider   ExternalCourseProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  urlHistory CourseSourceUrlHistory[]

  @@unique([providerId, sourceNativeKey, languageVersionKey])
  @@index([courseId])
  @@index([providerId])
  @@index([status])
}

model CourseSourceUrlHistory {
  id                     String    @id @default(uuid())
  courseSourceIdentityId String
  url                    String
  normalizedUrl          String
  isCurrent              Boolean   @default(false)
  firstSeenAt            DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())
  verificationState      String    @default("UNVERIFIED")
  responseCode           Int?
  redirectTarget         String?
  checkedAt              DateTime?
  changeImportRecordId   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sourceIdentity CourseSourceIdentity @relation(fields: [courseSourceIdentityId], references: [id], onDelete: Cascade)

  @@unique([courseSourceIdentityId, normalizedUrl])
  @@index([isCurrent])
  @@index([verificationState])
}

model CourseImportAnalysis {
  id                    String   @id @default(uuid())
  importRecordId        String   @unique
  providerCandidateId   String?
  resolvedProviderId    String?
  sourceNativeKey       String?
  normalizedPayload     Json
  eligibilityState      String
  completenessState     String
  matchState            String
  matchedCourseId       String?
  changeState           String
  fieldDiffs            Json?
  relationshipProposals Json?
  requiresReview        Boolean  @default(false)
  analyzedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  providerCandidate ExternalCourseProvider? @relation("CourseImportAnalysisProviderCandidate", fields: [providerCandidateId], references: [id], onDelete: SetNull)
  resolvedProvider  ExternalCourseProvider? @relation("CourseImportAnalysisResolvedProvider", fields: [resolvedProviderId], references: [id], onDelete: SetNull)
  matchedCourse     Course?                  @relation(fields: [matchedCourseId], references: [id], onDelete: SetNull)

  @@index([providerCandidateId])
  @@index([resolvedProviderId])
  @@index([matchedCourseId])
  @@index([changeState])
  @@index([requiresReview])
}

model CourseFieldProvenance {
  id                 String   @id @default(uuid())
  courseId           String
  fieldKey           String
  importRecordId     String
  sourceArtifactHash String
  sourceRowNumber    Int?
  providerId         String
  sourceUrl          String?
  valueHash          String
  importedAt         DateTime @default(now())
  reviewedBy         String?
  reviewStatus       String   @default("UNREVIEWED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  provider ExternalCourseProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([courseId, fieldKey, importRecordId])
  @@index([providerId])
  @@index([importRecordId])
  @@index([reviewStatus])
}

// --- Enterprise Event Foundation ---

model EnterpriseEventRecord {
  id                   String   @id
  reference            String   @unique
  ownerReference       String
  eventType            String
  category             String
  payloadMetadata      Json
  version              String
  metadata             Json
  correlationReference String?
  causationReference   String?
  lifecycleState       String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([ownerReference])
  @@index([eventType, lifecycleState])
  @@index([lifecycleState])
}

// --- Durable Background Jobs ---

model BackgroundJobRecord {
  id                 String   @id
  reference          String   @unique
  jobType            String
  parameters         Json
  ownerReference     String?
  priority           Int      @default(0)
  runAt              DateTime?
  cronExpression     String?
  timeoutSeconds     Int      @default(300)
  concurrentLimit    Int?
  maxAttempts        Int      @default(1)
  backoffType        String   @default("exponential")
  status             String   @default("SCHEDULED")
  attempt            Int      @default(0)
  availableAt        DateTime @default(now())
  leasedBy           String?
  leaseToken         String?
  leaseUntil         DateTime?
  heartbeatAt        DateTime?
  startedAt          DateTime?
  lastCompletedAt    DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  lastErrorCode      String?
  lastErrorText      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  executions BackgroundJobExecutionRecord[]
  deadLetter BackgroundJobDeadLetterRecord?

  @@index([status, availableAt, priority])
  @@index([leaseUntil])
  @@index([jobType, status])
  @@index([ownerReference])
}

model BackgroundJobExecutionRecord {
  id           String   @id @default(uuid())
  jobReference String
  attempt      Int
  workerId     String
  leaseToken   String   @unique
  startedAt    DateTime
  heartbeatAt  DateTime?
  finishedAt   DateTime?
  outcome      String   @default("RUNNING")
  errorCode    String?
  errorText    String?
  createdAt    DateTime @default(now())

  job BackgroundJobRecord @relation(fields: [jobReference], references: [reference], onDelete: Cascade)

  @@index([jobReference, attempt])
  @@index([outcome, startedAt])
  @@index([jobReference, startedAt])
}

model BackgroundJobDeadLetterRecord {
  id           String   @id @default(uuid())
  jobReference String   @unique
  jobType      String
  payload      Json
  attempt      Int
  errorCode    String
  errorText    String
  failedAt     DateTime
  replayedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job BackgroundJobRecord @relation(fields: [jobReference], references: [reference], onDelete: Cascade)

  @@index([failedAt])
  @@index([jobType, failedAt])
}

// --- Transactional Outbox ---

model TransactionalOutboxRecord {
  id            String    @id
  eventType     String
  domain        String
  aggregateType String?
  aggregateId   String?
  payload       Json
  metadata      Json
  correlationId String?
  causationId   String?
  state         String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  claimedBy     String?
  claimToken    String?
  claimUntil    DateTime?
  processedAt   DateTime?
  lastErrorCode String?
  lastErrorText String?
  lastFailedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([state, availableAt])
  @@index([claimUntil])
  @@index([domain, aggregateType, aggregateId])
  @@index([correlationId])
}

// --- Universities ---

model University {
  id                     String  @id @default(uuid())
  publicId               String  @unique
  slug                   String  @unique
  canonicalName          String
  canonicalDedupKey      String  @unique
  displayName            String
  country                String?
  city                   String?
  institutionType        String?
  officialWebsite        String?
  status                 String
  completenessStatus     String
  sourceUrl              String?
  officialSourceUrl      String?
  logoAssetId            String?
  foundedYear            Int?
  sourceImportRecordId   String?
  optionalFields         Json?
  countryReferenceId     String?
  regionReferenceId      String?
  cityReferenceId        String?
  institutionalOwnership String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countryReference      ReferenceCountry?                @relation(fields: [countryReferenceId], references: [id], onDelete: Restrict)
  regionReference       AdministrativeRegion?            @relation(fields: [regionReferenceId], references: [id], onDelete: SetNull)
  cityReference         ReferenceCity?                   @relation(fields: [cityReferenceId], references: [id], onDelete: SetNull)
  campuses              UniversityCampus[]
  organizationUnits     UniversityOrganizationUnit[]
  academicPrograms      UniversityAcademicProgram[]
  tuitionProfiles       UniversityTuitionProfile[]
  accommodationProfiles UniversityAccommodationProfile[]
  rankings              UniversityRanking[]
  sourceRecords         UniversitySourceRecord[]
  translations          UniversityTranslation[]
  localizedTexts        UniversityLocalizedText[]
  importChanges         UniversityImportChange[]
  scholarshipLinks      ScholarshipUniversityLink[]
  sponsoredScholarshipContexts ScholarshipSponsorContext[]

  @@index([countryReferenceId])
  @@index([regionReferenceId])
  @@index([cityReferenceId])
}

model UniversityCampus {
  id                 String                       @id @default(uuid())
  universityId       String
  sourceReferenceId  String?
  name               String
  campusType         String?
  status             String                       @default("ACTIVE")
  address            String?
  countryReferenceId String?
  regionReferenceId  String?
  cityReferenceId    String?
  latitude           Float?
  longitude          Float?
  coordinateSource   String?
  metadata           Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  university         University                   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  countryReference   ReferenceCountry?            @relation(fields: [countryReferenceId], references: [id], onDelete: Restrict)
  regionReference    AdministrativeRegion?        @relation(fields: [regionReferenceId], references: [id], onDelete: SetNull)
  cityReference      ReferenceCity?               @relation(fields: [cityReferenceId], references: [id], onDelete: SetNull)
  organizationUnits  UniversityOrganizationUnit[]
  programLinks       UniversityProgramCampus[]

  @@unique([universityId, sourceReferenceId])
  @@index([universityId])
  @@index([countryReferenceId])
  @@index([regionReferenceId])
  @@index([cityReferenceId])
}

model UniversityOrganizationUnit {
  id                       String                       @id @default(uuid())
  universityId             String
  campusId                 String?
  parentOrganizationUnitId String?
  sourceReferenceId        String?
  unitType                 String
  name                     String
  normalizedName           String
  status                   String                       @default("ACTIVE")
  metadata                 Json?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  university               University                   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  campus                   UniversityCampus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  parent                   UniversityOrganizationUnit?  @relation("UniversityOrganizationHierarchy", fields: [parentOrganizationUnitId], references: [id], onDelete: SetNull)
  children                 UniversityOrganizationUnit[] @relation("UniversityOrganizationHierarchy")
  programs                 UniversityAcademicProgram[]

  @@unique([universityId, unitType, normalizedName, parentOrganizationUnitId])
  @@index([universityId])
  @@index([campusId])
  @@index([parentOrganizationUnitId])
}

model UniversityAcademicProgram {
  id                    String                                  @id @default(uuid())
  universityId          String
  organizationUnitId    String?
  sourceReferenceId     String?
  sourceProgramName     String
  normalizedName        String
  degreeLevelId         String?
  majorId               String?
  majorMappingState     String
  status                String                                  @default("DRAFT")
  metadata              Json?
  createdAt             DateTime                                @default(now())
  updatedAt             DateTime                                @updatedAt
  university            University                              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  organizationUnit      UniversityOrganizationUnit?             @relation(fields: [organizationUnitId], references: [id], onDelete: SetNull)
  degreeLevel           DegreeLevel?                            @relation(fields: [degreeLevelId], references: [id], onDelete: SetNull)
  major                 Major?                                  @relation(fields: [majorId], references: [id], onDelete: SetNull)
  campuses              UniversityProgramCampus[]
  admissionRequirements UniversityProgramAdmissionRequirement[]
  scholarshipLinks      ScholarshipUniversityLink[]

  @@unique([universityId, sourceReferenceId])
  @@index([universityId])
  @@index([organizationUnitId])
  @@index([degreeLevelId])
  @@index([majorId])
  @@index([majorMappingState])
}

model UniversityProgramCampus {
  academicProgramId String
  campusId          String
  createdAt         DateTime                  @default(now())
  academicProgram   UniversityAcademicProgram @relation(fields: [academicProgramId], references: [id], onDelete: Cascade)
  campus            UniversityCampus          @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([academicProgramId, campusId])
  @@index([campusId])
}

model UniversityProgramAdmissionRequirement {
  id                  String                    @id @default(uuid())
  academicProgramId   String
  internationalTestId String
  testVariantId       String?
  testVersionId       String?
  minimumScore        Float?
  sectionScores       Json?
  validityMetadata    Json?
  restrictionMetadata Json?
  status              String                    @default("REVIEW_REQUIRED")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  academicProgram     UniversityAcademicProgram @relation(fields: [academicProgramId], references: [id], onDelete: Cascade)
  internationalTest   InternationalTest         @relation(fields: [internationalTestId], references: [id], onDelete: Restrict)
  testVariant         InternationalTestVariant? @relation(fields: [testVariantId], references: [id], onDelete: SetNull)
  testVersion         InternationalTestVersion? @relation(fields: [testVersionId], references: [id], onDelete: SetNull)

  @@unique([academicProgramId, internationalTestId, testVariantId, testVersionId])
  @@index([internationalTestId])
  @@index([testVariantId])
  @@index([testVersionId])
}

model UniversityTuitionProfile {
  id                   String             @id @default(uuid())
  universityId         String
  profileType          String
  organizationUnitName String?
  amount               Decimal?           @db.Decimal(18, 2)
  currencyCode         String?
  currencyReferenceId  String?
  officialSourceUrl    String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  university           University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  currency             ReferenceCurrency? @relation("UniversityTuitionCurrency", fields: [currencyReferenceId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([profileType])
  @@index([currencyReferenceId])
}

model UniversityAccommodationProfile {
  id                            String             @id @default(uuid())
  universityId                  String
  accommodationAvailable        Boolean?
  internationalEligible         Boolean?
  typicalCost                   Decimal?           @db.Decimal(18, 2)
  currencyCode                  String?
  currencyReferenceId           String?
  averageMonthlyLivingCost      Decimal?           @db.Decimal(18, 2)
  livingCostCurrencyCode        String?
  livingCostCurrencyReferenceId String?
  costVariationNote             String?
  metadata                      Json?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  university                    University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  currency                      ReferenceCurrency? @relation("UniversityAccommodationCurrency", fields: [currencyReferenceId], references: [id], onDelete: SetNull)
  livingCostCurrency            ReferenceCurrency? @relation("UniversityAccommodationLivingCostCurrency", fields: [livingCostCurrencyReferenceId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([currencyReferenceId])
  @@index([livingCostCurrencyReferenceId])
}

model UniversityRanking {
  id                String     @id @default(uuid())
  universityId      String
  provider          String
  rankingYear       Int
  rank              String
  scope             String
  scopeLabel        String?
  note              String?
  officialSourceUrl String
  verifiedAt        DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, provider, rankingYear, scope])
  @@index([provider, rankingYear, scope])
}

model UniversitySourceRecord {
  id               String                    @id @default(uuid())
  sourceIdentityKey String                    @unique
  universityId     String
  importRecordId   String?
  stage            String
  sourceArtifactId String
  sourceRowNumber  Int?
  sourceHash       String
  sourceUri        String?
  sourceLocale     String?
  importedAt       DateTime?
  metadata         Json?
  createdAt        DateTime                  @default(now())
  university       University                @relation(fields: [universityId], references: [id], onDelete: Cascade)
  translations     UniversityTranslation[]   @relation("UniversityTranslationSourceRecord")
  localizedTexts   UniversityLocalizedText[] @relation("UniversityLocalizedTextSourceRecord")

  @@index([stage, sourceArtifactId, sourceRowNumber])
  @@index([universityId])
  @@index([sourceHash])
}

model UniversityTranslation {
  id             String   @id @default(uuid())
  universityId   String
  locale         String
  displayName    String?
  description    String?
  reviewStatus   String   @default("NEEDS_REVIEW")
  sourceRecordId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  university   University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  sourceRecord UniversitySourceRecord? @relation("UniversityTranslationSourceRecord", fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([universityId, locale])
  @@index([locale])
  @@index([reviewStatus])
  @@index([sourceRecordId])
}

model UniversityLocalizedText {
  id             String   @id @default(uuid())
  universityId   String
  targetType     String
  targetId       String
  fieldKey       String
  locale         String
  value          String
  reviewStatus   String   @default("NEEDS_REVIEW")
  sourceRecordId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  university   University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  sourceRecord UniversitySourceRecord? @relation("UniversityLocalizedTextSourceRecord", fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@unique([universityId, targetType, targetId, fieldKey, locale])
  @@index([universityId, targetType, targetId])
  @@index([locale])
  @@index([reviewStatus])
  @@index([sourceRecordId])
}

model UniversityImportChangeSet {
  id               String                   @id
  importBatchId    String?
  sourceArtifactId String
  stage            String
  state            String                   @default("PLANNED")
  approvedBy       String?
  appliedAt        DateTime?
  rolledBackAt     DateTime?
  createdAt        DateTime                 @default(now())
  changes          UniversityImportChange[]

  @@index([state])
  @@index([sourceArtifactId])
}

model UniversityImportChange {
  id           String                    @id @default(uuid())
  changeSetId  String
  universityId String?
  entityType   String
  entityId     String
  operation    String
  beforeState  Json?
  afterState   Json?
  sequence     Int
  createdAt    DateTime                  @default(now())
  changeSet    UniversityImportChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  university   University?               @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@unique([changeSetId, sequence])
  @@index([universityId])
  @@index([entityType, entityId])
}

// --- Scholarships ---

model Scholarship {
  id                   String    @id @default(uuid())
  publicId             String    @unique
  slug                 String    @unique
  canonicalName        String
  canonicalDedupKey    String    @unique
  displayName          String
  providerName         String?
  status               String
  completenessStatus   String
  verificationStatus   String    @default("PENDING")
  publicationStatus    String    @default("DRAFT")
  amountMinorUnits     String?
  amountCurrencyCode   String?
  isFullyFunded        Boolean   @default(false)
  applicationDeadline  DateTime?
  officialWebsite      String?
  sourceUrl            String?
  optionalFields       Json?
  academicYear         String?
  cycleName            String?
  countryReferenceId   String?
  countrySourceLabel   String?
  countryScope         String?
  fundingTypeCode      String?
  deadlineType         String?
  applicationMethod    String?
  applicationUrl       String?
  officialSourceUrl    String?
  sourceImportRecordId String?
  sourceLocale         String?
  lastVerifiedAt       DateTime?
  studyLanguageReferenceId String?
  studyLanguageSourceLabel String?
  studyLanguageResolutionStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryCountry    ReferenceCountry?             @relation("ScholarshipPrimaryCountry", fields: [countryReferenceId], references: [id], onDelete: SetNull)
  studyLanguage     ReferenceLanguage?            @relation("ScholarshipStudyLanguage", fields: [studyLanguageReferenceId], references: [id], onDelete: SetNull)
  benefits          ScholarshipBenefit[]
  degreeTargets     ScholarshipDegreeTarget[]
  majorTargets      ScholarshipMajorTarget[]
  eligibilityItems  ScholarshipEligibilityItem[]
  requiredDocuments ScholarshipRequiredDocument[]
  sourceEvidence    ScholarshipSourceEvidence[]
  universityLinks   ScholarshipUniversityLink[]
  versions          ScholarshipVersion[]
  sponsorContext    ScholarshipSponsorContext?
  applicationCycles ScholarshipApplicationCycle[]

  @@index([countryReferenceId])
  @@index([academicYear])
  @@index([applicationDeadline])
  @@index([status, completenessStatus])
  @@index([publicationStatus])
  @@index([verificationStatus])
  @@index([studyLanguageReferenceId])
}

model ScholarshipBenefit {
  id                  String   @id @default(uuid())
  scholarshipId       String
  benefitKey          String
  benefitTypeCode     String
  coverageTypeCode    String?
  amount              Decimal? @db.Decimal(18, 2)
  currencyReferenceId String?
  valueText           String?
  durationText        String?
  frequencyCode       String?
  isCovered           Boolean  @default(true)
  isOptional          Boolean  @default(false)
  displayOrder        Int      @default(0)
  notes               String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scholarship Scholarship        @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  currency    ReferenceCurrency? @relation("ScholarshipBenefitCurrency", fields: [currencyReferenceId], references: [id], onDelete: SetNull)

  @@unique([scholarshipId, benefitKey])
  @@index([scholarshipId])
  @@index([benefitTypeCode])
  @@index([currencyReferenceId])
}

model ScholarshipDegreeTarget {
  id               String   @id @default(uuid())
  scholarshipId    String
  targetKey        String
  degreeLevelId    String?
  sourceLabel      String?
  resolutionStatus String   @default("PENDING")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scholarship Scholarship  @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
