model CmsContentNode {
  id                String   @id @default(uuid())
  publicId          String   @unique
  slug              String
  siteIdentifier    String   @default("MANARATAK")
  primaryLocale     String   @default("ar")
  contentType       String
  status            String   @default("DRAFT")
  title             String
  summary           String?
  categoryId        String?
  categorySlug      String?
  authorId          String
  ownerId           String
  version           Int      @default(1)
  featuredAssetId   String?
  seoMetadata       Json?
  editorialMetadata Json?
  metadata          Json?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category           CmsCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  localizedPayloads  CmsLocalizedContent[]
  publishedPayloads  CmsPublishedContent[]
  ledger              CmsEditorialLedger[]
  domainLinks         CmsContentDomainLink[]

  @@index([status, updatedAt])
  @@index([contentType, status])
  @@index([categoryId, status])
  @@index([siteIdentifier, status])
  @@index([authorId])
  @@index([ownerId])
  @@unique([siteIdentifier, slug])
}


model CmsContentDomainLink {
  id           String   @id @default(uuid())
  contentId    String
  targetType   String
  targetId     String
  relationType String   @default("RELATED")
  sortOrder    Int      @default(0)
  metadata     Json?
  createdBy    String
  createdAt    DateTime @default(now())

  content CmsContentNode @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, targetType, targetId, relationType])
  @@index([targetType, targetId, sortOrder])
  @@index([contentId, sortOrder])
}

model CmsLocalizedContent {
  id                 String   @id @default(uuid())
  contentId          String
  siteIdentifier     String
  locale             String
  localizedSlug      String
  state              String   @default("DRAFT")
  version            Int      @default(1)
  title              String
  summary            String?
  body                String
  readingTimeMinutes Int?
  featuredAssetId    String?
  seoMetadata        Json?
  metadata           Json?
  lastModifiedBy     String
  scheduledAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  content     CmsContentNode        @relation(fields: [contentId], references: [id], onDelete: Restrict)
  tags        CmsContentTag[]
  attachments CmsContentAttachment[]
  reviews     CmsWorkflowReview[]
  revisions   CmsContentRevision[]

  @@unique([contentId, locale])
  @@unique([siteIdentifier, locale, localizedSlug])
  @@index([state, scheduledAt])
  @@index([contentId, state])
}

model CmsCategory {
  id                 String   @id @default(uuid())
  slug               String   @unique
  nameAr             String
  nameEn             String
  descriptionAr      String?
  descriptionEn      String?
  parentCategoryId   String?
  status             String   @default("ACTIVE")
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parent   CmsCategory?  @relation("CmsCategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children CmsCategory[] @relation("CmsCategoryTree")
  contents CmsContentNode[]

  @@index([status])
  @@index([parentCategoryId])
}

model CmsTag {
  id              String   @id @default(uuid())
  normalizedValue String   @unique
  labelAr         String
  labelEn         String
