  updatedAt       DateTime @updatedAt

  contents CmsContentTag[]
}

model CmsContentTag {
  localizedContentId String
  tagId              String

  localizedContent CmsLocalizedContent @relation(fields: [localizedContentId], references: [id], onDelete: Cascade)
  tag              CmsTag              @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([localizedContentId, tagId])
  @@index([tagId])
}

model CmsContentAttachment {
  id                 String @id @default(uuid())
  localizedContentId String
  assetId            String
  role               String @default("ATTACHMENT")
  sortOrder          Int    @default(0)
