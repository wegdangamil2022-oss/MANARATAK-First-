// --- Phase 21 Career & Alumni Platform (P8 source closure) ---
model CareerEmployerRecord {
  id                    String   @id @default(uuid())
  publicId              String   @unique
  slug                  String   @unique
  canonicalName         String
  canonicalDedupKey     String   @unique
  displayName           String
  employerType          String
  industry              String?
  countryReferenceId    String?
  cityReferenceId       String?
  country               String?
  city                  String?
  websiteUrl            String?
  logoAssetId           String?
  verificationStatus    String
  description           String?
  metadata              Json?
  version                    Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  countryReference      ReferenceCountry? @relation(fields: [countryReferenceId], references: [id], onDelete: Restrict)
  cityReference         ReferenceCity?    @relation(fields: [cityReferenceId], references: [id], onDelete: Restrict)
  jobs                  CareerJobPostingRecord[]

  @@unique([id, version])
  @@index([verificationStatus, employerType])
  @@index([countryReferenceId])
  @@index([cityReferenceId])
}

model CareerJobPostingRecord {
  id                    String   @id @default(uuid())
  publicId              String   @unique
  slug                  String   @unique
  canonicalTitle        String
  canonicalDedupKey     String   @unique
  title                 String
  opportunityType       String
  employmentType        String
  jobCategory           String
  description           String
  countryReferenceId    String
  cityReferenceId       String?
  country               String?
  city                  String?
  status                String
  employerId            String
  recruiterContactId    String?
  applicationDeadline   DateTime?
  externalPostingUrl    String?
  salaryRange           Json?
  requiredSkills        Json?
  educationRequirement  String?
  languageRequirements  Json?
  remoteOption          Boolean  @default(false)
  metadata              Json?
  version                    Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  employer              CareerEmployerRecord @relation(fields: [employerId], references: [id], onDelete: Restrict)
  countryReference      ReferenceCountry      @relation(fields: [countryReferenceId], references: [id], onDelete: Restrict)
  cityReference         ReferenceCity?        @relation(fields: [cityReferenceId], references: [id], onDelete: Restrict)
  applications          CareerApplicationRecord[]

  @@unique([id, version])
  @@index([status, updatedAt])
  @@index([countryReferenceId, cityReferenceId])
  @@index([employerId, status])
}


// --- Phase 21 Career/Alumni owner persistence expansion (MNT-AUD-0055) ---
model CareerProfileRecord {
  id                 String   @id @default(uuid())
  studentReferenceId String   @unique
  headline           String?
  summary            String?
  skills             Json
  resumeAssetId      String?
  visibility         String
  version            Int      @default(1)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([visibility, updatedAt])
  @@index([resumeAssetId])
}

model CareerApplicationRecord {
  id                 String   @id @default(uuid())
  publicId           String   @unique
  jobId              String
  studentReferenceId String
  cvAssetId          String
  coverLetter        String?
  jobSnapshot        Json
  status             String
  submittedAt        DateTime @default(now())
  withdrawnAt        DateTime?
  decisionMetadata   Json?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  job                CareerJobPostingRecord @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, studentReferenceId])
  @@index([studentReferenceId, status, updatedAt])
  @@index([jobId, status, updatedAt])
  @@index([cvAssetId])
}

model CareerAlumniProfileRecord {
  id                 String   @id @default(uuid())
  studentReferenceId String   @unique
  displayName        String
  graduationYear     Int?
  programReferenceId String?
  employerName       String?
  visibility         String
  consentGrantedAt   DateTime?
  consentGrantedBy   String?
  consentSource      String?
  consentRevokedAt   DateTime?
  consentRevokedBy   String?
  version            Int      @default(1)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([visibility, updatedAt])
  @@index([programReferenceId])
}

// --- Phase 05 Foundation Control Plane durable persistence (MNT-AUD-0049) ---
model WorkflowControlRecord {
  id             String   @id
  reference      String   @unique
  ownerReference String
  lifecycleState String
  version        String
  snapshot       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerReference])
  @@index([lifecycleState])
}

model ApiServiceControlRecord {
  id             String   @id
  reference      String   @unique
  ownerReference String
  lifecycleState String
  version        String
  snapshot       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerReference])
  @@index([lifecycleState])
}

model SharedComponentControlRecord {
  id             String   @id
  reference      String
  ownerReference String
  lifecycleState String
  version        String
  snapshot       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([reference, version])
  @@index([reference])
  @@index([ownerReference])
  @@index([lifecycleState])
}

model WorkflowExecutionProjection {
  workflowReference String   @id
  executionCount    Int      @default(0)
  lastExecutedAt    DateTime?
  updatedAt         DateTime @updatedAt
}

model ApiServiceExposureProjection {
  serviceReference String   @id
  serviceId        String
  lifecycleState   String
  exposureIntent   Json
  exposedAt        DateTime?
  decommissionedAt DateTime?
  updatedAt        DateTime @updatedAt
}

model SharedComponentRenderingProjection {
  componentReference String   @id
  componentId        String
  version            String
  lifecycleState     String
  definition         Json
  renderingIntent    Json
  synchronizedAt     DateTime?
  decommissionedAt   DateTime?
  updatedAt          DateTime @updatedAt
}

model NotificationTemplateRecord {
  id                String   @id
  channels          Json
  requiredVariables Json
  localizations     Json
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  intents NotificationIntentRecord[]
}

model NotificationIntentRecord {
  id                  String   @id
  reference           String   @unique
  templateId          String
  recipientReference  String
  variables           Json
  scheduledAt         DateTime?
  expiresAt           DateTime?
  retryMaxRetries     Int      @default(5)
  retryBackoffMs      Int      @default(1000)
  state               String   @default("CREATED")
  deliveryState       String   @default("PENDING")
  attempts            Int      @default(0)
  nextAttemptAt       DateTime @default(now())
  leaseWorkerId       String?
  leaseToken          String?
  leaseUntil          DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  deliveredAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  template NotificationTemplateRecord @relation(fields: [templateId], references: [id], onDelete: Restrict)
  receipts NotificationDeliveryReceipt[]

  @@index([deliveryState, nextAttemptAt])
  @@index([recipientReference, createdAt])
}

model NotificationDeliveryReceipt {
  id                String   @id @default(uuid())
  intentId          String
  attempt           Int
  status            String
  providerMessageId String?
  metadata          Json?
  errorCode         String?
  createdAt         DateTime @default(now())

  intent NotificationIntentRecord @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([intentId, attempt])
  @@index([status, createdAt])
}

// --- API Foundation: Canonical Command Idempotency ---

model ApiIdempotencyRecord {
  id                 String    @id @default(uuid())
  scopeHash          String    @unique
  principalId        String
  method             String
  routeKey           String
  keyHash            String
  requestFingerprint String
  state              String
  statusCode         Int?
  responseBody       Json?
  leaseToken         String?
  leaseExpiresAt     DateTime?
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([expiresAt])
  @@index([principalId, createdAt])
}

// W4 — durable search execution history; public result pagination is cursor/keyset based.
model ApiSearchRequestRecord {
  id              String   @id
  reference       String
  scope           String
  query           String
  filters         Json
  logicalOperator String
  page            Int
  limit           Int
  sortField       String?
  sortDirection   String?
  state           String
  totalCount      Int?
  executionTimeMs Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reference, createdAt])
  @@index([scope, createdAt])
  @@index([createdAt])
}
