  localizedContent CmsLocalizedContent @relation(fields: [localizedContentId], references: [id], onDelete: Cascade)

  @@unique([localizedContentId, assetId, role])
  @@index([assetId])
}

model CmsWorkflowReview {
  id                 String   @id @default(uuid())
  localizedContentId String
  status             String   @default("PENDING")
  requestedBy        String
  requestedAt        DateTime @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?
  comments           String?

  localizedContent CmsLocalizedContent @relation(fields: [localizedContentId], references: [id], onDelete: Restrict)

  @@index([localizedContentId, status])
  @@index([status, requestedAt])
}

model CmsContentRevision {
  id                 String   @id @default(uuid())
  localizedContentId String
  versionNumber      Int
  reason             String
  payload            Json
  capturedBy         String
  capturedAt         DateTime @default(now())

  localizedContent CmsLocalizedContent @relation(fields: [localizedContentId], references: [id], onDelete: Restrict)

  @@unique([localizedContentId, versionNumber])
  @@index([localizedContentId, capturedAt])
}

model CmsPublishedContent {
  id                 String   @id @default(uuid())
  contentId          String
  publicId           String
  siteIdentifier     String
  locale             String
  slug               String
  canonicalUrl       String
  contentType        String
  title              String
  summary            String?
  body                String
  categorySlug       String?
  featuredAssetId    String?
  attachmentAssetIds Json
  tags               Json
  seoMetadata        Json
  versionNumber      Int
  status             String   @default("PUBLISHED")
  publishedAt        DateTime
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  content CmsContentNode @relation(fields: [contentId], references: [id], onDelete: Restrict)

  @@unique([contentId, locale])
  @@unique([siteIdentifier, locale, slug])
  @@index([siteIdentifier, locale, status, publishedAt])
  @@index([contentType, locale, status])
  @@index([categorySlug, locale, status])
}

model CmsEditorialLedger {
