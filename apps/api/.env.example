# --- API ENVIRONMENT CONFIGURATION EXAMPLE (apps/api/.env.example) ---
# This file mirrors the API/server portion of the canonical root `.env.example`.
# Production & Staging: mandatory values MUST be supplied by deployment configuration/secret custody.
# CI validates this inventory against packages/config/src/AppConfig.ts.

# --- RUNTIME ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
OTEL_SERVICE_NAME=manaratak-api
# Production/Staging: REQUIRED. HTTPS OpenTelemetry collector/gateway endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com

# --- SECURITY & SECRETS (REQUIRED IN PRODUCTION / STAGING) ---
# RS256 access-token signing. Never commit real private-key material.
JWT_ACTIVE_KEY_ID=manaratak-key-2026-01
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_PUBLIC_KEYS_JSON={}
ACCESS_TOKEN_TTL_SECONDS=900
JWT_ISSUER=manaratak-production-api
JWT_AUDIENCE=manaratak-production-browser

CSRF_SECRET=your-32-character-csrf-secret-placeholder
SECURE_COOKIE=true
ADMIN_AUTH_MODE=strict
TRUST_PROXY_HOPS=1
SECURITY_CSP_ENABLED=true
SECURITY_RATE_LIMIT_MAX=100
SECURITY_RATE_LIMIT_WINDOW_MS=60000

# --- DATABASE & DISTRIBUTED RUNTIME ---
# Production/Staging: PostgreSQL and managed Redis are both REQUIRED.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manaratak_dev
REDIS_URL=redis://redis-host:6379
REDIS_NAMESPACE=manaratak:

# Greenfield database write gate. Keep closed unless an explicit controlled operation is running.
DATABASE_PROVISIONING_GATE=PENDING
ALLOW_DATABASE_MUTATIONS=NO
DATABASE_MUTATION_ENVIRONMENT=development
DATABASE_MUTATION_PURPOSE=provision
DATABASE_MUTATION_TARGET=localhost:5432/manaratak_dev
ALLOW_PRODUCTION_DATABASE_MUTATIONS=NO
DATABASE_PRODUCTION_CHANGE_ID=

# --- NETWORKING & CORS ---
API_BASE_URL=https://api.manaratak.org
CORS_ORIGIN=https://app.manaratak.org
PUBLIC_WEB_URL=https://app.manaratak.org
ADMIN_WEB_URL=https://admin.manaratak.org

# --- WORKERS ---
# Production/Staging: REQUIRED and enabled. Development/test may set false.
CERTIFICATE_COMPLETION_WORKER_ENABLED=true
CERTIFICATE_COMPLETION_WORKER_INTERVAL_MS=5000
STUDENT_WORKSPACE_OUTBOX_WORKER_ENABLED=true
STUDENT_WORKSPACE_OUTBOX_WORKER_INTERVAL_MS=2000
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_WORKER_INTERVAL_MS=2000
BACKGROUND_WORKER_BATCH_SIZE=10
BACKGROUND_WORKER_LEASE_MS=60000
BACKGROUND_WORKER_HEARTBEAT_MS=15000
BACKGROUND_RETENTION_CRON=15 2 * * *
BACKGROUND_CMS_CRON=* * * * *
BACKGROUND_IMPORT_CRON=* * * * *
BACKGROUND_AI_CRON=* * * * *
BACKGROUND_FINANCE_RECONCILIATION_CRON=*/5 * * * *

# --- STORAGE / CERTIFICATE TRUST RUNTIME ---
STORAGE_BASE_PATH=./storage
CERTIFICATE_PUBLIC_VERIFICATION_BASE_URL=https://app.manaratak.org
CERTIFICATE_SIGNING_KEY_REFERENCE=kms://your-certificate-signing-key
# Development-only fallback. Production must use the approved KMS/HSM custody path.
CERTIFICATE_SIGNING_SECRET=development-only-certificate-signing-secret

# --- PHASE 05 ENTERPRISE ASSET PROVIDER ---
# Required together in production/staging; secrets are runtime-injected, never committed.
MANARATAK_ASSET_PROVIDER_BASE_URL=https://asset-provider.example.invalid/api/
MANARATAK_ASSET_PROVIDER_API_KEY=replace-at-runtime
MANARATAK_ASSET_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-bytes-at-runtime
MANARATAK_ASSET_PROVIDER_TIMEOUT_MS=10000
MANARATAK_ASSET_PROVIDER_MAX_RESPONSE_BYTES=67108864
MANARATAK_ASSET_PROVIDER_ALLOW_INSECURE_HTTP=false

# Import raw provenance retention (provider-enforced)
MANARATAK_IMPORT_RAW_RETENTION_DAYS=365
OWNER_DOMAIN_OUTBOX_WORKER_ENABLED=true
OWNER_DOMAIN_OUTBOX_WORKER_INTERVAL_MS=2000
BACKGROUND_NOTIFICATION_CRON=* * * * *
NOTIFICATION_RECIPIENT_MAX_DELIVERIES_PER_HOUR=30

# --- PHASE 19 FINANCE PROVIDER ---
FINANCE_PROVIDER_BASE_URL=https://finance-provider.example.com
FINANCE_PROVIDER_API_KEY=replace-with-provider-api-key
FINANCE_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-random-characters
FINANCE_PAYMENT_PROVIDER_KEY=primary-payment
FINANCE_FX_PROVIDER_KEY=primary-fx
FINANCE_BANK_PROVIDER_KEY=primary-bank
FINANCE_PROVIDER_TIMEOUT_MS=10000
FINANCE_PROVIDER_MAX_ATTEMPTS=3
FINANCE_PROVIDER_ALLOW_INSECURE_HTTP=false

# --- P05 NOTIFICATION PROVIDER ---
NOTIFICATION_PROVIDER_BASE_URL=https://notification-provider.example.com
NOTIFICATION_PROVIDER_API_KEY=replace-with-provider-api-key
NOTIFICATION_PROVIDER_SIGNING_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
NOTIFICATION_PROVIDER_ALLOW_INSECURE_HTTP=false
