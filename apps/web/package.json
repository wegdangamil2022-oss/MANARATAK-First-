{
  "name": "@manaratak/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "build": "node --max-old-space-size=4096 ../../node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "prerender": "node ../../scripts/prerender-public-seo.mjs",
    "build:production": "npm run build && npm run prerender"
  },
  "dependencies": {
    "@manaratak/shared": "*",
    "@manaratak/types": "*",
    "@manaratak/ui": "*",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.2.3"
  }
}
